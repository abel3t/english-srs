{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phraseloop",
  "account_id": "c18f977cd2f14dba42041672d8472f03",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phraseloop",
      "database_id": "f48c849a-02ce-41d9-a413-bb5d8a0a9455",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI: Deepgram Aura-2 speech for clips (free daily allowance).
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "phraseloop-audio"
    }
  ]
}
