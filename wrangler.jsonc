{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-srs",
  "account_id": "c18f977cd2f14dba42041672d8472f03",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "OLLAMA_BASE_URL": "https://ollama.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-srs",
      "database_id": "407834ef-3a4d-40f0-bb14-5c658bb0a679",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "english-srs-audio"
    }
  ]
}
